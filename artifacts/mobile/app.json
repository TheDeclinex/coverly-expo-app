{
  "expo": {
    "owner": "coverly",
    "name": "Coverly",
    "slug": "coverly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/coverly-app-icon-1024.png",
    "scheme": "coverly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand/coverly-native-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/brand/coverly-app-icon-1024.png",
      "splash": {
        "image": "./assets/brand/coverly-native-splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#F8FAFC"
      },
      "bundleIdentifier": "nz.coverly.app",
      "associatedDomains": [
        "applinks:www.coverly.nz"
      ],
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Allow Coverly to use your microphone to add item details by voice."
      }
    },
    "android": {
      "package": "nz.coverly.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.coverly.nz",
              "pathPrefix": "/open"
            },
            {
              "scheme": "https",
              "host": "www.coverly.nz",
              "pathPrefix": "/auth/verified"
            },
            {
              "scheme": "https",
              "host": "www.coverly.nz",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 1,
      "icon": "./assets/brand/coverly-android-icon-safe.png",
      "splash": {
        "image": "./assets/brand/coverly-native-splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#F8FAFC"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/coverly-android-adaptive-foreground-safe.png",
        "backgroundColor": "#F6FBFA"
      },
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/brand/coverly-app-icon-1024.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/brand/coverly-native-splash.png",
          "imageWidth": 430,
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "ios": {
            "backgroundColor": "#F8FAFC",
            "image": "./assets/brand/coverly-native-splash.png",
            "imageWidth": 430,
            "resizeMode": "cover"
          },
          "android": {
            "backgroundColor": "#F8FAFC",
            "image": "./assets/brand/coverly-native-splash.png",
            "imageWidth": 430,
            "resizeMode": "cover"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Coverly to take property, room, item and evidence photos.",
          "photosPermission": "Allow Coverly to choose property, room, item and evidence photos.",
          "microphonePermission": "Allow Coverly to record room walkthrough videos for item scanning."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Coverly to use your microphone to add item details by voice."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e5e80314-7ccd-4981-97c4-5be844c2967a"
      }
    }
  }
}
