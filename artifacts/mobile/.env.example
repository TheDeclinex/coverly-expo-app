# Supabase public client configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat / native billing
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=coverly_access
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=

# Temporary pre-launch switch. false shows/logs gates without blocking actions.
EXPO_PUBLIC_BILLING_GATES_ENABLED=false

# Do not place service-role keys or server-side API secrets in this file.

# Future one-time ownership mapping. Intentionally blank until separately approved
# store setup. Exact product IDs per platform and the exact RevenueCat LIFETIME
# package identifier are required; no fallback to legacy subscription packages.
EXPO_PUBLIC_REVENUECAT_OWNED_IOS_PRODUCT_ID=
EXPO_PUBLIC_REVENUECAT_OWNED_ANDROID_PRODUCT_ID=
EXPO_PUBLIC_REVENUECAT_OWNED_PACKAGE_ID=
