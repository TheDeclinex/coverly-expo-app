# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional for local development; required for preview and production. This
# must be the project ref from the URL above, and contains no secret.
EXPO_PUBLIC_EXPECTED_SUPABASE_PROJECT_REF=

# RevenueCat / native billing
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_PLUS_ENTITLEMENT_ID=Coverly Plus
EXPO_PUBLIC_REVENUECAT_FAMILY_ENTITLEMENT_ID=Coverly Family
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=
# sandbox for local/preview builds; production for store builds.
EXPO_PUBLIC_REVENUECAT_ENV=sandbox

# Local development may use false. Preview and production must use true.
EXPO_PUBLIC_BILLING_GATES_ENABLED=false

# Optional app config
EXPO_PUBLIC_APP_ENV=development

# Supabase Edge Function secrets for revenuecat-webhook
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PLUS_ENTITLEMENT_IDS=Coverly Plus
REVENUECAT_FAMILY_ENTITLEMENT_IDS=Coverly Family
REVENUECAT_PLUS_PRODUCT_IDS=
REVENUECAT_FAMILY_PRODUCT_IDS=
# Local-only escape hatch. Do not enable in production.
REVENUECAT_ALLOW_INSECURE_WEBHOOK=false

# Do not commit real secrets.
# Do not place service-role Supabase keys in the mobile app.
